+// Reject, before the narrow phase, a body pair the game has already said must not collide (the ShouldCollide cache). Without it a
+// filtered pair still got a full contact computation every step and was then turned into a sensor (OnContactAdded): about twice the
+// physics cost of IVP with overlapping non-colliding ragdolls. Sensors (triggers) and pairs without a cached answer are left alone, so
+// their events are unchanged. VJOLT_NO_PAIR_PREFILTER=1 turns it off.
+static bool VJoltBroadPhasePairFilter( const JPH::Body &inBody1, const JPH::Body &inBody2 )
+{
+	if ( inBody1.IsSensor() || inBody2.IsSensor() )
+		return true;
+	auto *pObject1 = reinterpret_cast<JoltPhysicsObject *>( inBody1.GetUserData() );
+	auto *pObject2 = reinterpret_cast<JoltPhysicsObject *>( inBody2.GetUserData() );
+	if ( !pObject1 || !pObject2 )
+		return true;
+	JoltPhysicsEnvironment *pEnvironment = pObject1->GetJoltEnvironment();
+	if ( !pEnvironment || pEnvironment != pObject2->GetJoltEnvironment() )
+		return true;
+	return !pEnvironment->GetContactListener()->CachedPairRejected( pObject1, pObject2 );
+}
+
+static void VJoltInstallPairFilter()
+{
+	const char *off = getenv( "VJOLT_NO_PAIR_PREFILTER" );
+	JPH::Body::sPairFilter = ( off && off[0] == '1' ) ? nullptr : VJoltBroadPhasePairFilter;
+}
