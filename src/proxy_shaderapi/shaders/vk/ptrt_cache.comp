#version 450
// PT-RT (analysis/43): the radiance cache update. Each frame a slice of the cascades' voxels (page-major: level, brick, voxel; the slice
// moves on every frame) gathers the light arriving at it: the sun (a voxel shadow ray), one lamp resampled from 8 candidates, and one
// cosine ray that reads the cache where it lands (or the sky), so each pass adds a bounce; the light leaving it (albedo x that) is blended
// into the cache with a running mean (at most the last 16 samples count).
layout(local_size_x = 64) in;

#define RAD_ACCESS
#include "ptrt_vox.glsl"
layout(push_constant) uniform C { uint start, count, frame, total; } cc;   // the slice: [start, start + count) mod total voxels

void main() {
    if (gl_GlobalInvocationID.x >= cc.count) return;
    uint id = (cc.start + gl_GlobalInvocationID.x) % cc.total;
    uint page = id / 512u, vi = id % 512u;
    int l = int(page / 4096u);
    uint pi = page % 4096u;
    uint bi = pk.w[PAGES + page];
    if (bi == 0u) return;
    uint b0 = uint(BRICKS) + (bi - 1u) * 1024u;
    uint a = pk.w[b0 + vi * 2u];
    if ((a >> 24) == 0u) return;
    uint nn = pk.w[b0 + vi * 2u + 1u];
    vec3 albedo = vec3(float(a & 255u), float((a >> 8) & 255u), float((a >> 16) & 255u)) / 255.0;
    vec3 n = normalize(vec3(float(int(nn << 24) >> 24), float(int(nn << 16) >> 24), float(int(nn << 8) >> 24)) + 1e-4);
    uint side = (id + cc.frame / 2u) & 1u;   // the two sides take turns
    if (side == 1u) n = -n;
    float vs = float(8 << l);
    ivec3 k = ivec3(int(pi % 16u), int((pi / 16u) % 16u), int(pi / 256u));
    ivec3 v = ivec3(int(vi % 8u), int((vi / 8u) % 8u), int(vi / 64u));
    vec3 p = (vec3(level_org(l) * BRICK + k * BRICK + v) + 0.5) * vs;   // the voxel's centre
    vec3 o = p + n * (vs * 0.87 + 1.0);                                    // out of its own voxel along the normal
    vec3 sun = fvec(20), sunc = fvec(24), sky = fvec(28);
    uint seed = hash(id * 747796405u + cc.frame * 2891336453u);
    vec3 E = vec3(0);
    Hit h;
    float ndl = dot(n, sun);
    if (ndl > 0.0 && !trace(o, sun, 1.0, 65536.0, h)) E += sunc * ndl;
    uint nl = pk.w[33], lo = pk.w[34];
    if (nl > 0u) {   // one lamp, resampled as in ptrt_trace.comp
        float wsum = 0.0, wpick = 0.0; vec3 cpick = vec3(0), lpick = vec3(0); float dpick = 0.0;
        for (int c = 0; c < 8; c++) {
            uint li = min(uint(rnd(seed) * float(nl)), nl - 1u);
            vec3 ld3; float ld;
            vec3 f = lamp_light(lo + li * 20u, p, n, ld3, ld);
            float w = luma(f);
            wsum += w;
            if (w > 0.0 && rnd(seed) * wsum < w) { wpick = w; cpick = f; lpick = ld3; dpick = ld; }
        }
        if (wpick > 0.0 && !trace(o, lpick, 1.0, dpick - vs, h)) E += cpick * (wsum / 8.0 * float(nl)) / wpick;
    }
    vec3 tx = normalize(abs(n.x) < 0.9 ? cross(n, vec3(1, 0, 0)) : cross(n, vec3(0, 1, 0))), ty = cross(n, tx);
    float u1 = rnd(seed), u2 = rnd(seed), r = sqrt(u1), ph = 6.2831853 * u2;
    vec3 dir = normalize(r * cos(ph) * tx + r * sin(ph) * ty + sqrt(max(0.0, 1 - u1)) * n);
    if (!trace(o, dir, 1.0, 65536.0, h)) E += sky;
    else E += rad_get(h.vid, side_seen(h.n, dir)).rgb;   // the light leaving where it lands (0 until that voxel has been gathered)
    if (any(isnan(E)) || any(isinf(E))) return;   // a degenerate lamp (zero attenuation) or the like: never into the cache
    uint ci = ((bi - 1u) * 512u + vi) * 2u + side;
    vec4 old = rad_get((bi - 1u) * 512u + vi, side);
    float cnt = min(old.w + 1.0, 16.0);
    vec3 nw = mix(old.rgb, albedo * E, 1.0 / cnt);
    rc.r[ci * 2u] = packHalf2x16(nw.rg);
    rc.r[ci * 2u + 1u] = packHalf2x16(vec2(nw.b, cnt));
}
