#version 450
// VK0 spike: a moving pattern written by a compute shader into a D3D9 texture through DXVK's interop (vkbridge.c).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D img;
layout(push_constant) uniform P { float t; } pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(img);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2 uv = vec2(p) / vec2(sz);
    float r = 0.5 + 0.5 * sin(uv.x * 12.0 + pc.t * 2.0);
    float g = 0.5 + 0.5 * sin(uv.y * 9.0 - pc.t * 1.3);
    float b = ((p.x / 16 + p.y / 16) & 1) == 0 ? 0.9 : 0.2;
    imageStore(img, p, vec4(r, g, b, 1.0));
}
